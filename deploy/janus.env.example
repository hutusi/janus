# Janus service secrets. Install as /etc/janus/janus.env, fill in the values, then:
#   sudo chown root:root /etc/janus/janus.env && sudo chmod 600 /etc/janus/janus.env
#
# systemd reads this file as root and injects the variables into the service, so
# the unprivileged janus user never reads it directly. Keeping secrets here (not
# in janus.yml) is why janus.yml can stay group-readable by the janus user.
#
# See docs/configuration.md and docs/gitlab-webhook-setup.md.

# Bearer token for /api/*. POST /api/trigger REQUIRES it (it runs code on the
# host); other /api/* endpoints are open when it is unset. Generate one with:
#   openssl rand -hex 32
JANUS_API_TOKEN=

# GitLab webhook secret. Enables POST /webhooks/gitlab when set (404 otherwise).
# Use the same value in the GitLab webhook's "Secret token" field. Generate with:
#   openssl rand -hex 24
JANUS_GITLAB_SECRET=

# Optional: outbound GitLab API token (api scope) for commit-status reporting.
# JANUS_GITLAB_API_TOKEN=

# Optional: other providers. Set a webhook secret to enable that endpoint
# (/webhooks/github, /webhooks/gitee, /webhooks/gitcode); generate each with
# `openssl rand -hex 24`. GitHub can also report commit status via its API token
# (repo:status scope). Gitee and GitCode have no commit-status API.
#   JANUS_GITHUB_SECRET=
#   JANUS_GITHUB_API_TOKEN=
#   JANUS_GITEE_SECRET=
#   JANUS_GITCODE_SECRET=
